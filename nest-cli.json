{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "api-gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false
  },
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "api-gateway",
      "entryFile": "main",
      "sourceRoot": "api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "api-gateway/tsconfig.json"
      }
    },
    "auth-service": {
      "type": "application",
      "root": "services/auth-service",
      "entryFile": "main",
      "sourceRoot": "services/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "services/auth-service/tsconfig.json"
      }
    },
    "user-service": {
      "type": "application",
      "root": "services/user-service",
      "entryFile": "main",
      "sourceRoot": "services/user-service/src",
      "compilerOptions": {
        "tsConfigPath": "services/user-service/tsconfig.json"
      }
    },
    "sales-service": {
      "type": "application",
      "root": "services/sales-service",
      "entryFile": "main",
      "sourceRoot": "services/sales-service/src",
      "compilerOptions": {
        "tsConfigPath": "services/sales-service/tsconfig.json"
      }
    },
    "product-service": {
      "type": "application",
      "root": "services/product-service",
      "entryFile": "main",
      "sourceRoot": "services/product-service/src",
      "compilerOptions": {
        "tsConfigPath": "services/product-service/tsconfig.json"
      }
    },
    "marketing-service": {
      "type": "application",
      "root": "services/marketing-service",
      "entryFile": "main",
      "sourceRoot": "services/marketing-service/src",
      "compilerOptions": {
        "tsConfigPath": "services/marketing-service/tsconfig.json"
      }
    },
    "reporting-service": {
      "type": "application",
      "root": "services/reporting-service",
      "entryFile": "main",
      "sourceRoot": "services/reporting-service/src",
      "compilerOptions": {
        "tsConfigPath": "services/reporting-service/tsconfig.json"
      }
    },
    "traceability-service": {
      "type": "application",
      "root": "services/traceability-service",
      "entryFile": "main",
      "sourceRoot": "services/traceability-service/src",
      "compilerOptions": {
        "tsConfigPath": "services/traceability-service/tsconfig.json"
      }
    }
  }
}